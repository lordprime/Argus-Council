# Which release to run. The compose file pulls ghcr.io/lordprime/argus-council/{api,web,runner}
# at this version; pin it (e.g. 0.1.4) so a restart never jumps to a newer release by itself.
# ./scripts/deploy.sh pulls this release too and runs it as local argus-council/* images;
# ./scripts/deploy.sh --local builds the checkout instead and ignores this value.
ARGUS_VERSION=latest
# ARGUS_IMAGE_REPO=ghcr.io/lordprime/argus-council

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ARGUS_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ARGUS_SANDBOX_TOKEN=

# Optional
ARGUS_CORS_ORIGINS=http://localhost:8080
# The very first account can always register (and becomes admin). Keep self-registration off
# afterwards unless anyone who can reach the site should be able to get an account.
ARGUS_ALLOW_REGISTRATION=false
ARGUS_BOOTSTRAP_ADMIN_EMAIL=
ARGUS_BOOTSTRAP_ADMIN_PASSWORD=
ARGUS_API_BIND=127.0.0.1
ARGUS_API_PORT=8000
ARGUS_WEB_BIND=0.0.0.0
ARGUS_WEB_PORT=8080

# Separate key for encrypting stored provider credentials (defaults to one derived from ARGUS_SECRET_KEY)
ARGUS_ENCRYPTION_KEY=

# Outbound requests to private / loopback networks (SSRF guard). Off by default; enable only if your
# webhooks, MCP servers or remote agents (CONNECTIONS), or pages the agents fetch (WEB_FETCH), live
# on an internal network. Link-local / cloud-metadata addresses are refused regardless.
ARGUS_CONNECTIONS_ALLOW_PRIVATE_URLS=false
ARGUS_WEB_FETCH_ALLOW_PRIVATE_URLS=false
# web_fetch: render pages that need JavaScript in headless Chromium when their HTML has almost no
# text. Requires the backend's `browser` extra (playwright) and `playwright install chromium`.
ARGUS_WEB_FETCH_RENDER_JS=false
# LLM providers that users add in the UI: set true to allow self-hosted model servers (Ollama,
# vLLM, LM Studio) on private addresses. System providers set via ARGUS_*_BASE_URL always work.
ARGUS_PROVIDER_ALLOW_PRIVATE_URLS=false

# System-wide LLM providers (optional; users can add their own per account)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Self-hosted, OpenAI-compatible endpoints
ARGUS_OLLAMA_BASE_URL=
ARGUS_VLLM_BASE_URL=
ARGUS_LMSTUDIO_BASE_URL=

# CLI agents: the vendors' official CLIs (claude, codex, gemini) as council agents, run by the
# separate `runner` container. Off by default. Each vendor's terms govern its CLI; subscription
# logins (Claude Pro/Max, ChatGPT Plus/Pro, a Google account) are for the account owner's own use.
# On an instance shared by several people, use API keys (ALLOW_SUBSCRIPTION=false enforces that).
# Install it with ./scripts/deploy.sh --with cli-agents (--without cli-agents removes it and keeps
# the users' sign-ins), then sign a CLI in with ./scripts/agent-login.sh <email> <claude|codex|gemini>.
# See docs/cli-agents.md.
# COMPOSE_PROFILES lists the installed opt-in features (cli-agents, browser; comma-separated). The
# scripts derive ARGUS_CLI_AGENTS_ENABLED, ARGUS_BROWSER_URL and the runner and browser tokens from
# it, so it is the only setting to change here (by hand too: update.sh follows it). Admins turn an
# installed feature on and off at any time, without a restart, in Settings -> Features.
COMPOSE_PROFILES=
ARGUS_CLI_AGENTS_ENABLED=false
ARGUS_RUNNER_TOKEN=
ARGUS_CLI_AGENTS_ALLOWED=claude,codex,gemini
ARGUS_CLI_AGENTS_ALLOW_SUBSCRIPTION=true
ARGUS_CLI_AGENTS_TIMEOUT_S=600
# Optional egress proxy for the runner that allow-lists the vendor API hosts
ARGUS_RUNNER_HTTPS_PROXY=
ARGUS_RUNNER_NO_PROXY=

# Live browser: agents read pages in a real, read-only Chrome (the `browse` tool) and you can watch
# them. Runs as the separate `browser` container behind the `egress` proxy, which never lets it
# reach private, loopback or link-local addresses. Off by default. Install it with
# ./scripts/deploy.sh --with browser (adds `browser` to COMPOSE_PROFILES above); the scripts then
# fill ARGUS_BROWSER_URL=unix:/run/argus-browser/browser.sock and ARGUS_BROWSER_TOKEN, and clear the
# URL again after --without browser. Admins turn it on and off in Settings -> Features.
ARGUS_BROWSER_URL=
ARGUS_BROWSER_TOKEN=
# Browser sessions across the service, per run, and the idle timeout in seconds
ARGUS_BROWSER_MAX_SESSIONS=4
ARGUS_BROWSER_SESSIONS_PER_RUN=2
ARGUS_BROWSER_IDLE_TIMEOUT_S=300
# Seconds one browser action may take (passed to both the API and the browser container)
ARGUS_BROWSER_ACTION_TIMEOUT_S=30

# Web search for research councils: searxng (self-hosted) | tavily | brave
ARGUS_SEARCH_PROVIDER=
ARGUS_SEARCH_API_KEY=
ARGUS_SEARXNG_URL=

# Prometheus scraping: /metrics requires "Authorization: Bearer <token>" (disabled in production when unset)
ARGUS_METRICS_TOKEN=

# Data retention, in days (0 = keep forever). Applied hourly by the API in small batches;
# admins can preview and run it under Settings -> Data & privacy.
#   RUN_DAYS:    delete finished runs (with their events, artifacts and artifact files)
#   EVENT_DAYS:  drop only the event log of finished runs; the run, its result and artifacts stay
#   AUDIT_DAYS:  delete audit-trail rows
#   LEDGER_DAYS: the protocol ledger is hash-chained and verified from its first entry, so pruning
#                it makes verification fail permanently. Keep 0 unless you archive it elsewhere.
#   TRASH_DAYS:  permanently delete runs that have been in the trash this long
ARGUS_RETENTION_RUN_DAYS=0
ARGUS_RETENTION_EVENT_DAYS=0
ARGUS_RETENTION_AUDIT_DAYS=365
ARGUS_RETENTION_LEDGER_DAYS=0
ARGUS_RETENTION_TRASH_DAYS=30
# Keep every page agents read (web_fetch) in each user's "Research library" knowledge base
ARGUS_KNOWLEDGE_CAPTURE_ENABLED=true
# Backups kept by scripts/update.sh (newest database + artifact pairs; 0 keeps all)
ARGUS_BACKUP_KEEP=14
